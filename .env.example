# Copy this file to .env and adjust values. Never commit the real .env.

# Runtime environment: dev | staging | prod
APP_ENV=dev

# Fixed docker compose project name so container names are stable across runs
# (scripts/dev-start.sh defaults to this; prevents port collisions with other
# compose projects — see README "Local dev start-up")
# COMPOSE_PROJECT_NAME=second-brain-dev

# Postgres connection (matches docker-compose.yml defaults; the compose stack
# publishes the dedicated port 27432 -> container-internal 5432)
# WORKTREE WARNING: this default IS the live service's database name. In any
# git worktree, point DATABASE_URL at a `*_test` dbname (e.g.
# .../brain_test) BEFORE running alembic or the app — alembic env.py refuses
# live-dbname URLs unless BRAIN_ALLOW_LIVE=1, but do not rely on that.
DATABASE_URL=postgresql+psycopg://brain:brain@localhost:27432/brain

# Qdrant vector database (matches docker-compose.yml defaults; dedicated
# host port 27333)
QDRANT_URL=http://localhost:27333
QDRANT_COLLECTION=brain_items
QDRANT_TIMEOUT_S=10
# QDRANT_API_KEY=

# Jev typed-decision API (classification + rerank; optional: items stay in
# the inbox and search falls back to keyword when unconfigured)
# JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=5000

# IANA zone used to interpret zone-less pasted times (Gmail dates, WhatsApp
# timestamps, copied calendar text) before storing them as aware UTC.
# Default: this machine's local zone (e.g. Asia/Jerusalem).
# TIMEZONE=Asia/Jerusalem

# Telegram bot (optional extra: pip install -e '.[telegram]'; long polling,
# no webhook). When TELEGRAM_BOT_TOKEN is set, TELEGRAM_ALLOWED_USER_IDS is
# REQUIRED: comma-separated Telegram user ids allowed to talk to the bot;
# anyone else gets no reply (their id is logged once, INFO level). To find
# your id: brain telegram --whoami-hint
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=

# Provider selection: the defaults need NO API keys — the LLM runs on your
# local Claude Code login (check with: claude; /login if needed) and
# embeddings run locally via fastembed (downloads its model on first run).
# LLM_PROVIDER=claude_sdk        # claude_sdk | anthropic
# EMBEDDER_PROVIDER=fastembed    # fastembed | openai

# Local LLM via Claude Code login (claude_sdk provider; optional overrides)
# CLAUDE_SDK_MODEL=              # unset = the model your login defaults to
#                                # e.g. claude-haiku-5-5 for faster /ask,
#                                # claude-sonnet-5-5 for quality
# CLAUDE_SDK_TIMEOUT_S=120

# Ask retrieval (optional overrides)
# ASK_TOP_K=8          # sources kept in the LLM prompt after rerank
# ASK_RECALL_POOL=32   # candidates fetched for the reranker (a deep pool lets
#                      # the reranker surface cross-language matches that score
#                      # ~0.2 cosine; one rerank call, ~4x documents)

# Local embeddings (fastembed provider; optional overrides)
# FASTEMBED_MODEL=minishlab/potion-multilingual-128M (multilingual, 256 dims).
# Changing FASTEMBED_MODEL changes the vector dimension: run `brain reindex` once
# to rebuild the collection (Postgres is the source of truth).

# OpenAI embeddings (only when EMBEDDER_PROVIDER=openai; optional: search
# falls back to keyword)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TIMEOUT_S=30

# Anthropic API LLM (only when LLM_PROVIDER=anthropic; optional: /ask
# returns 502 when unconfigured)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TIMEOUT_S=60

# Email source (F2): read-only Gmail label poller. The OAuth refresh token
# lives in the macOS login keychain (run `brain gmail-auth` once); it is
# NEVER stored here. See docs/email-setup.md for the one-time Google setup.
# GMAIL_LABEL_ID=Label_1234567890
# GMAIL_QUERY=newer_than:30d
# GMAIL_POLL_INTERVAL_S=60
# GMAIL_CREDENTIALS_PATH=~/.config/second-brain/gmail-client-secret.json
# The Gmail account the connector syncs — required by `brain gmail-label
# --auth`: the consented profile must match it or nothing is stored.
# GMAIL_ACCOUNT=you@gmail.com
