# Copy this file to .env and adjust values. Never commit the real .env.

# Runtime environment: dev | staging | prod
APP_ENV=dev

# Fixed docker compose project name so container names are stable across runs
# (scripts/dev-start.sh defaults to this; prevents port collisions with other
# compose projects that publish 5432/6333 — see README "Local dev start-up")
# COMPOSE_PROJECT_NAME=second-brain-dev

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5432/brain

# Qdrant vector database (matches docker-compose.yml defaults)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=brain_items
QDRANT_TIMEOUT_S=10
# QDRANT_API_KEY=

# Jev typed-decision API (classification + rerank; optional: items stay in
# the inbox and search falls back to keyword when unconfigured)
# JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=5000

# Provider selection: the defaults need NO API keys — the LLM runs on your
# local Claude Code login (check with: claude; /login if needed) and
# embeddings run locally via fastembed (downloads its model on first run).
# LLM_PROVIDER=claude_sdk        # claude_sdk | anthropic
# EMBEDDER_PROVIDER=fastembed    # fastembed | openai

# Local LLM via Claude Code login (claude_sdk provider; optional overrides)
# CLAUDE_SDK_MODEL=              # unset = the model your login defaults to
# CLAUDE_SDK_TIMEOUT_S=120

# Local embeddings (fastembed provider; optional overrides)
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# OpenAI embeddings (only when EMBEDDER_PROVIDER=openai; optional: search
# falls back to keyword)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TIMEOUT_S=30

# Anthropic API LLM (only when LLM_PROVIDER=anthropic; optional: /ask
# returns 502 when unconfigured)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TIMEOUT_S=60
