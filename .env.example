# Copy this file to .env and adjust values. Never commit the real .env.

# Runtime environment: dev | staging | prod
APP_ENV=dev

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5432/brain

# Qdrant vector database (matches docker-compose.yml defaults)
QDRANT_URL=http://localhost:6333
