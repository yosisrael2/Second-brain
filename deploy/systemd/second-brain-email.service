# Second Brain — Gmail poller. Linux replacement for com.secondbrain.email (launchd).
# Install: see deploy/README.md. Paths assume the checkout at /opt/second-brain.
#
# Restart=on-failure keeps the launchd KeepAlive contract of scripts/run-email.sh:
# it exits 0 for permanent problems (disabled, config error) and non-zero for
# transient ones, so only the transient ones restart.
[Unit]
Description=Second Brain Gmail poller
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/second-brain
# Claude Code login for the claude_sdk LLM (CLAUDE_CODE_OAUTH_TOKEN from
# `claude setup-token`). The app reads .env itself, but the SDK subprocess
# only sees real environment variables. "-" = optional file.
EnvironmentFile=-/root/.config/second-brain/claude.env
ExecStart=/opt/second-brain/scripts/run-email.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
